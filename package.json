{
  "name": "zenc-lang",
  "displayName": "Zen C - CE",
  "description": "Language support for Zen C",
  "version": "0.0.6",
  "publisher": "zenc-lang-ce",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenc-lang-ce/zenc-vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zenc",
        "aliases": [
          "Zen C",
          "zenc"
        ],
        "extensions": [
          ".zc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "zenc"
      }
    ],
    "grammars": [
      {
        "language": "zenc",
        "scopeName": "source.zenc-lang-ce",
        "path": "./syntaxes/zenc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenc-lang-ce.restartServer",
        "title": "Restart Language Server",
        "category": "Zen C"
      },
      {
        "command": "zenc-lang-ce.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Zen C"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zen C",
      "properties": {
        "zenc-lang-ce.serverPath": {
          "type": [
            "string",
            "null"
          ],
          "default": "",
          "description": "Path to the Zen C language server (zc-lsp). When empty, zc-lsp is looked up in PATH, and if it is not there the extension asks where it is. A path to the zc compiler also works: the zc-lsp next to it is used, or `zc lsp` with compilers that predate zc-lsp."
        },
        "zenc-lang-ce.server.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Start the language server with --verbose, so it logs what it does to the \"Zen C Language Server\" output."
        },
        "zenc-lang-ce.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the language server in the \"Zen C Language Server\" output."
        },
        "zenc-lang-ce.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the Zen C language server. When disabled, syntax highlighting and editing support remain."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle -- --minify",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap",
    "compile": "tsc -p ./",
    "watch": "npm run bundle -- --watch",
    "package": "vsce package",
    "test": "npm run compile && node out/test/server.test.js"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.19.0",
    "esbuild": "^0.27.2",
    "ovsx": "^1.3.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
